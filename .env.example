# ── Growth Assistant — Environment Template ──
# Copy: cp backend/.env.example backend/.env  (and frontend/.env if needed)
# Never commit real secrets. See README for details.

# ── Provider Toggle ──
# Options: ollama | anthropic | groq
# ollama    = local (no key, requires ollama serve + pull)
# anthropic = cloud (requires ANTHROPIC_API_KEY from https://console.anthropic.com/)
# groq      = cloud (requires GROQ_API_KEY from https://console.groq.com/keys)
# Fallback: no auto-switch. If selected provider fails → API returns SSE error / 503; change LLM_PROVIDER and restart.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_MODELS=llama3.1:8b

# Anthropic Claude — Agent SDK / Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MODELS=claude-3-5-sonnet-20241022,claude-3-5-haiku-20241022,claude-3-opus-20240229
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Groq — OpenAI-compatible (https://api.groq.com/openai/v1)
# Get key: https://console.groq.com/keys → set GROQ_API_KEY
# Models (choose one for GROQ_MODEL, allowlist via GROQ_MODELS):
#   llama-3.3-70b-versatile      131K 280t/s — default, versatile
#   openai/gpt-oss-120b          131K 500t/s — reasoning
#   llama-3.1-8b-instant         131K 560t/s — fast/cheap
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Fallback / local embedding (no key needed)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIM=384

# ── Database (Docker default) ──
DATABASE_URL=postgresql+asyncpg://lenny:lenny@postgres:5432/lenny_growth
# Local dev override (when running uvicorn outside Docker):
# DATABASE_URL=postgresql+asyncpg://lenny:lenny@localhost:5432/lenny_growth

# ── Retrieval ──
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_K=8
CANDIDATE_K=30
RAG_MIN_CONFIDENCE=0.01
EMBED_BATCH_SIZE=32

# ── App ──
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
LOG_LEVEL=INFO
